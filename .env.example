# Supabase Configuration
# Your Supabase project URL - found in your Supabase dashboard under Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key - found in your Supabase dashboard under Settings > API
# This key is safe to use in client-side code
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# API Timeout Configuration (optional)
# Timeout for API requests in milliseconds (default: 30000 = 30 seconds)
# Increase this value if you experience timeout issues
VITE_API_TIMEOUT=30000